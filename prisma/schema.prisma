generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SHOPIFY SESSION
// ============================================================

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================================
// TRADE APPLICATION
// ============================================================

model TradeApplication {
  id String @id @default(cuid())

  firstName String
  lastName  String
  email     String
  phone     String

  businessName      String
  businessType      String
  businessTypeOther String?

  website   String?
  instagram String?

  companyNumber String?
  vatNumber     String?

  yearsTrading        String?
  typicalProjectValue String?

  portfolioUrl       String?
  projectInformation String?

  address  String
  city     String
  county   String?
  postcode String
  country  String?

  termsAccepted Boolean @default(false)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedAt DateTime?
  rejectedAt DateTime?

  status String @default("PENDING")

  tradeAccount TradeAccount?
}

// ============================================================
// TRADE ACCOUNT
// ============================================================

model TradeAccount {
  id String @id @default(cuid())

  applicationId String @unique

  shopifyCustomerId String? @unique

  email        String
  businessName String

  // ==========================================================
  // PRICING MODEL
  // ==========================================================

  pricingOption PricingOption @default(TRADE_PRICE)

  // ==========================================================
  // STANDARD TRADE / REFERRAL SETTINGS
  // ==========================================================

  discountPercent   Decimal @default(0) @db.Decimal(5, 2)
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)

  allocationPercent Decimal @default(0) @db.Decimal(5, 2)

  // ==========================================================
  // REFERRAL
  // ==========================================================

  referralCode           String  @unique
  shopifyTradeDiscountId String?
  // ==========================================================
  // ACCOUNT STATUS
  // ==========================================================

  status TradeAccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONSHIPS
  // ==========================================================

  commissions Commission[]

  referrals Referral[]

  clientSpecialOffers ClientSpecialOffer[]

  application TradeApplication @relation(fields: [applicationId], references: [id])
}

// ============================================================
// REFERRAL
// ============================================================

model Referral {
  id String @id @default(cuid())

  tradeAccountId String

  referralCode String

  landingSessionId String?

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONSHIPS
  // ==========================================================

  commissions Commission[]

  tradeAccount TradeAccount @relation(fields: [tradeAccountId], references: [id])
}

// ============================================================
// CLIENT SPECIAL OFFER
// ============================================================
//
// Example:
//
// Designer allocation = 15%
//
// Client gets       = 5%
// Designer earns    = 10%
//
// 5% + 10% = 15%
//
// Another offer could be:
//
// Client gets       = 8%
// Designer earns    = 7%
//
// 8% + 7% = 15%
//
// The allocation is SNAPSHOTTED onto each offer.
// ============================================================

model ClientSpecialOffer {
  id String @id @default(cuid())

  // ==========================================================
  // OWNER
  // ==========================================================

  tradeAccountId String

  // ==========================================================
  // CLIENT INFORMATION
  // ==========================================================

  clientName        String?
  clientEmail       String?
  clientPhone       String?
  shopifyCustomerId String?
  // ==========================================================
  // SHOPIFY DISCOUNT CODE
  // ==========================================================
  shopifyDiscountId String?
  discountCode      String  @unique

  // ==========================================================
  // TOTAL ALLOCATION
  // ==========================================================

  allocationPercent Decimal @db.Decimal(5, 2)

  // ==========================================================
  // ALLOCATION SPLIT
  // ==========================================================

  clientDiscountPercent Decimal @db.Decimal(5, 2)

  commissionPercent Decimal @db.Decimal(5, 2)

  // ==========================================================
  // OFFER STATUS
  // ==========================================================

  status String @default("ACTIVE")

  expiresAt DateTime?

  // ==========================================================
  // DATES
  // ==========================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ==========================================================
  // RELATIONSHIPS
  // ==========================================================

  tradeAccount TradeAccount @relation(fields: [tradeAccountId], references: [id], onDelete: Cascade)

  commissions Commission[]
}

// ============================================================
// COMMISSION
// ============================================================

model Commission {
  id String @id @default(cuid())

  // ==========================================================
  // TRADE ACCOUNT
  // ==========================================================

  tradeAccountId String

  // ==========================================================
  // OPTIONAL REFERRAL
  // ==========================================================

  referralId String?

  // ==========================================================
  // OPTIONAL CLIENT SPECIAL OFFER
  // ==========================================================

  clientSpecialOfferId String?

  // ==========================================================
  // SHOPIFY ORDER
  // ==========================================================

  shopifyOrderId String @unique

  orderNumber String?

  // ==========================================================
  // ORDER VALUES
  // ==========================================================

  orderTotal Decimal @db.Decimal(12, 2)

  eligibleAmount Decimal @db.Decimal(12, 2)

  // ==========================================================
  // COMMISSION
  // ==========================================================

  commissionRate Decimal @db.Decimal(5, 2)

  commissionAmount Decimal @db.Decimal(12, 2)

  // ==========================================================
  // STATUS
  // ==========================================================

  status CommissionStatus @default(PENDING)

  // ==========================================================
  // DATES
  // ==========================================================

  createdAt DateTime @default(now())

  approvedAt DateTime?

  paidAt DateTime?

  // ==========================================================
  // RELATIONSHIPS
  // ==========================================================

  referral Referral? @relation(fields: [referralId], references: [id])

  clientSpecialOffer ClientSpecialOffer? @relation(fields: [clientSpecialOfferId], references: [id], onDelete: SetNull)

  tradeAccount TradeAccount @relation(fields: [tradeAccountId], references: [id])

  adjustments CommissionAdjustment[]
}

// ============================================================
// COMMISSION ADJUSTMENT
// ============================================================
//
// Records every financial adjustment made to a commission.
//
// Example:
//
// Original commission = £5.00
//
// Refund £20:
// Adjustment = -£1.00
//
// Remaining commission = £4.00
//
// Another refund £30:
// Adjustment = -£1.50
//
// Remaining commission = £2.50
//
// This creates a complete audit trail.
// ============================================================

model CommissionAdjustment {
  id String @id @default(cuid())

  // ==========================================================
  // COMMISSION
  // ==========================================================

  commissionId String

  // ==========================================================
  // SHOPIFY ORDER
  // ==========================================================

  shopifyOrderId String

  // ==========================================================
  // ADJUSTMENT TYPE
  // ==========================================================

  type CommissionAdjustmentType

  // ==========================================================
  // REFUND INFORMATION
  // ==========================================================

  shopifyRefundId String?

  shopifyTransactionId String?

  // ==========================================================
  // AMOUNTS
  // ==========================================================

  refundAmount Decimal? @db.Decimal(12, 2)

  commissionAdjustment Decimal @db.Decimal(12, 2)

  // ==========================================================
  // COMMISSION AFTER THIS ADJUSTMENT
  // ==========================================================

  commissionAfterAdjustment Decimal @db.Decimal(12, 2)

  // ==========================================================
  // OPTIONAL NOTE
  // ==========================================================

  note String?

  // ==========================================================
  // DATE
  // ==========================================================

  createdAt DateTime @default(now())

  // ==========================================================
  // RELATIONSHIP
  // ==========================================================

  commission Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  // ==========================================================
  // INDEXES
  // ==========================================================

  @@index([commissionId])
  @@index([shopifyOrderId])
  @@index([shopifyTransactionId])
}

// ============================================================
// COMMISSION ADJUSTMENT TYPE
// ============================================================

enum CommissionAdjustmentType {
  REFUND
  CANCELLATION
  ORDER_UPDATE
  MANUAL
}

// ============================================================
// ENUMS
// ============================================================

enum TradeAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PricingOption {
  TRADE_PRICE
  REFERRAL
  CLIENT_SPECIAL_PRICE
}
